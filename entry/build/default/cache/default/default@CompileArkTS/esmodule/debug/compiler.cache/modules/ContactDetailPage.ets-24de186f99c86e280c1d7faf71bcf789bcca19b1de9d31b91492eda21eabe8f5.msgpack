            let contactsData = JSON.parse(data);
            this.name = contactsData.name;
            this.address = contactsData.address;
            this.telephony = contactsData.telephony;
            this.email = contactsData.email;
            this.remarks = contactsData.remarks;
            // è§£æåˆ†ç»„åç§°ï¼Œå…¼å®¹æ—§æ•°æ®
            this.groupName = contactsData.groupName || '';
