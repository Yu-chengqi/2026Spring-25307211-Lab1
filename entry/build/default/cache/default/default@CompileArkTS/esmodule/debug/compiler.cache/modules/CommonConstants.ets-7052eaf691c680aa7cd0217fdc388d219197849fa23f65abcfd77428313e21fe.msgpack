   * Contacts name max length.
   */
  static readonly CONTACTS_NAME_MAX_LENGTH: number = 10;
  /**
   * Contacts tel max length.
   */
  static readonly CONTACTS_TEL_MAX_LENGTH: number = 11;
  /**
