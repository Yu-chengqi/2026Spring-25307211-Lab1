    /**
     * è§£æ MM-DD æ ¼å¼çš„ç”Ÿæ—¥ä¸º Date å¯¹è±¡
     * ç”¨äºæ—¥æœŸé€‰æ‹©å™¨çš„åˆå§‹å€¼æ˜¾ç¤º
     */
    parseMonthDay(birthday) {
        try {
            const parts = birthday.split('-');
            if (parts.length === 2) {
                const month = parseInt(parts[0]) - 1; // æœˆä»½ä»0å¼€å§‹
                const day = parseInt(parts[1]);
                // ä½¿ç”¨å½“å‰å¹´ä»½ä½œä¸ºåŸºå‡†
                return new Date(new Date().getFullYear(), month, day);
            }
        }
        catch (err) {
            hilog.error(0x0000, 'ContactAddAndEditPage', `Parse birthday failed`);
        }
        return new Date();
    }
