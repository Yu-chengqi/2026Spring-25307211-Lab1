            DatePicker.create({
                selected: this.birthday ? this.parseMonthDay(this.birthday) : new Date()
            });
            // æ—¥æœŸé€‰æ‹©å™¨ï¼ˆåªé€‰æ‹©æœˆæ—¥ï¼‰
            DatePicker.lunar(false);
            // æ—¥æœŸé€‰æ‹©å™¨ï¼ˆåªé€‰æ‹©æœˆæ—¥ï¼‰
            DatePicker.onDateChange((value) => {
                // æ ¼å¼åŒ–ä¸º MM-DDï¼ˆåªä¿å­˜æœˆæ—¥ï¼Œä¸ä¿å­˜å¹´ä»½ï¼‰
                const month = String(value.getMonth() + 1).padStart(2, '0');
                const day = String(value.getDate()).padStart(2, '0');
                this.birthday = `${month}-${day}`;
            });
        }, DatePicker);
        // æ—¥æœŸé€‰æ‹©å™¨ï¼ˆåªé€‰æ‹©æœˆæ—¥ï¼‰
        DatePicker.pop();
        this.observeComponentCreation2((elmtId, isInitialRender) => {
