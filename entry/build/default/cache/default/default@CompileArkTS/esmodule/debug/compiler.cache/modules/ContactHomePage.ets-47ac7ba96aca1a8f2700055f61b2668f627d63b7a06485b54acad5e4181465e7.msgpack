    getAllData() {
        this.kvManager.getEntries(CommonConstants.CONTACTS_DATABASE_KEY, (err, entries) => {
            hilog.info(0x0000, 'ContactHomePage', `getAllData entries: ${JSON.stringify(entries)}`);
            if (err) {
