                return;
            }
            let listItems = [];
            entries.forEach((item, index) => {
                let itemInfo = new ListItemData();
                let contactData = JSON.parse(item.value.value);
                itemInfo.name = contactData.name;
                // è§£æåˆ†ç»„åç§°å­—æ®µï¼Œå…¼å®¹æ—§æ•°æ®ï¼ˆæ— groupNameå­—æ®µæ—¶é»˜è®¤ä¸ºç©ºï¼‰
